<Window x:Class="MO2ExportImport.ImportSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MO2ExportImport"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        Title="Import Simulator" Height="450" Width="800">
  <Window.Resources>
    <!-- Converter to display the EventLog as a newline-separated string -->
    <local:CollectionToStringConverter x:Key="CollectionToStringConverter" />
  </Window.Resources>
  
  <Grid>
    <!-- Three rows: top (radio buttons), middle (main content), bottom (buttons) -->
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    
    <!-- Top row: Toggle radio buttons -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
      <RadioButton Content="Mods" GroupName="ListToggle" 
                   IsChecked="{Binding IsModListSelected}" Margin="5"/>
      <RadioButton Content="Plugins" GroupName="ListToggle" 
                   IsChecked="{Binding IsPluginListSelected}" Margin="5"/>
    </StackPanel>
    
    <!-- Middle row: Split view -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      
      <!-- Left: TreeView using Gong DragDrop -->
      <TreeView x:Name="SimulatorTreeView"
                Grid.Column="0"
                ItemsSource="{Binding SelectedSimulatorNodes}"
                dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"
                dd:DragDrop.DropHandler="{Binding DropHandler}"
                SelectedItemChanged="SimulatorTreeView_SelectedItemChanged">
        <TreeView.Resources>
          <!-- HierarchicalDataTemplate for ModSimulatorNode -->
          <HierarchicalDataTemplate DataType="{x:Type local:ModSimulatorNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="Normal"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                      <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </HierarchicalDataTemplate>
    
          <!-- HierarchicalDataTemplate for PluginSimulatorNode -->
          <HierarchicalDataTemplate DataType="{x:Type local:PluginSimulatorNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="Normal"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                      <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </HierarchicalDataTemplate>
        </TreeView.Resources>
      </TreeView>
      
      <!-- Right: Read-only TextBox displaying the EventLog of the selected node -->
      <TextBox Grid.Column="1" Margin="5" IsReadOnly="True" AcceptsReturn="True" 
               VerticalScrollBarVisibility="Auto"
               Text="{Binding SelectedSimulatorNode.EventLog, Converter={StaticResource CollectionToStringConverter}}" />
    </Grid>
    
    <!-- Bottom row: Proceed and Cancel buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
      <Button Content="Proceed" Command="{Binding ProceedCommand}" Margin="5" Width="100"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5" Width="100"/>
    </StackPanel>
  </Grid>
</Window>
