<Window x:Class="MO2ExportImport.Views.ExportPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:vms = "clr-namespace:MO2ExportImport.ViewModels"
        d:DataContext="{d:DesignInstance Type=vms:ExportPopupViewModel}"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Export Confirmation" Height="225" Width="400">
    <StackPanel>
        <Button Content="Calculate Space" 
                Command="{Binding CalculateSpaceCommand}" 
                Margin="10"
                ToolTip="Calculate the total size of selected mods and check if there is enough available disk space"/>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Export Folder Name:" Margin="10,0,0,5"/>
            <TextBox Text="{Binding ExportDestinationFolderName}" 
                     Margin="10,0,0,10" 
                     MinWidth="250"
                     ToolTip="Specify the name of the folder where mods will be exported"/>
        </StackPanel>

        <!-- Display space info with dynamic color -->
        <TextBlock Text="{Binding SpaceInfo}" 
                   Margin="10" 
                   Foreground="{Binding SpaceInfoColor}" 
                   TextWrapping="Wrap"/>

        <!-- Control buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Export Mods and List" 
                    Command="{Binding ExportModsAndListCommand}" 
                    IsEnabled="{Binding IsExportEnabled}" 
                    Margin="10"
                    ToolTip="Export all selected mod files and the mod list to the destination folder"/>
            <Button Content="Export List" 
                    Command="{Binding ExportListCommand}" 
                    Margin="10"
                    ToolTip="Export only the mod list (modlist.json) without copying mod files"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    Margin="10"
                    ToolTip="Cancel the export operation and close this window"/>
        </StackPanel>

    </StackPanel>
</Window>