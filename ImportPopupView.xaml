<Window x:Class="MO2ExportImport.Views.ImportPopupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:vms = "clr-namespace:MO2ExportImport.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vms:ImportPopupViewModel}"
        Title="Import Mods" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Calculate Space Button -->
        <Button Grid.Row="0" 
                Content="Calculate Space" 
                Command="{Binding CalculateSpaceCommand}" 
                Margin="10" 
                HorizontalAlignment="Center"
                ToolTip="Calculate the total size of mods to import and check if there is enough available disk space"/>

        <!-- Display calculated space and available space -->
        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="{Binding RequiredSpaceText}" Margin="5"/>
            <TextBlock Text="{Binding AvailableSpaceText}" Margin="5"/>
            <TextBlock Text="{Binding SpaceStatusText}" Margin="5" Foreground="{Binding SpaceStatusColor}"/>
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="2" Margin="10" Orientation="Horizontal">
            <CheckBox IsChecked="{Binding ShowModListPreview}"
                      ToolTip="When checked, display a preview of the final mod and plugin order before completing the import"/>
            <TextBlock Margin="5 0 0 0">Show Order Preview Before Importing</TextBlock>
        </StackPanel>

        <!-- Import and Cancel Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Import" 
                    Command="{Binding ImportCommand}" 
                    IsEnabled="{Binding IsImportEnabled}" 
                    Margin="5"
                    ToolTip="Begin importing the selected mods to the destination MO2 directory"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    Margin="5"
                    ToolTip="Cancel the import operation and close this window"/>
        </StackPanel>
    </Grid>
</Window>