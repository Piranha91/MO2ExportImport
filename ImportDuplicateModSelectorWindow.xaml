<Window x:Class="MO2ExportImport.ImportDuplicateModSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MO2ExportImport"
        d:DataContext="{d:DesignInstance Type=local:ImportDuplicateModSelectorViewModel}"
        mc:Ignorable="d"
        Title="Import Duplicate Mod Selector" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DuplicateMods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="Gray" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- ImportedMod.Name -->
                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                <!-- Version (Imported) label -->
                                <TextBlock Grid.Column="1" Text="Version (Imported):" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <!-- ImportedModVersion with color binding -->
                                <TextBlock Grid.Column="2" Text="{Binding ImportedModVersion}" 
                                           Foreground="{Binding ImportedVersionColor}" 
                                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <!-- Version (Existing) label -->
                                <TextBlock Grid.Column="3" Text="Version (Existing):" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <!-- DestinationExistingModVersion with color binding -->
                                <TextBlock Grid.Column="4" Text="{Binding DestinationExistingModVersion}" 
                                           Foreground="{Binding DestinationExistingModColor}" 
                                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <!-- Overwrite Existing label -->
                                <TextBlock Grid.Column="5" Text="Overwrite Existing" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <!-- Checkbox bound to OverwriteExistingMod -->
                                <CheckBox Grid.Column="6" IsChecked="{Binding OverwriteExistingMod}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="1" Content="OK" Command="{Binding ExitCommand}" HorizontalAlignment="Center" Margin="0,10,0,10"/>
    </Grid>
</Window>
